# Stripe secret for the selected Netlify context; never commit the real value.
STRIPE_SECRET_KEY=sk_test_replace_me

# Stripe webhook signing secret for the selected Netlify context.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Netlify URL or final custom domain, without a trailing slash.
SITE_URL=https://your-site-name.netlify.app

# IZHE Admin v2 — provider-neutral OpenID Connect configuration.
# The provider must enforce MFA and return verified email, acr, and/or amr claims.
IZHE_ADMIN_OIDC_ISSUER=https://identity-provider.example.com/
IZHE_ADMIN_OIDC_CLIENT_ID=replace_with_oidc_client_id
IZHE_ADMIN_OIDC_CLIENT_SECRET=replace_with_oidc_client_secret
IZHE_ADMIN_OIDC_REDIRECT_URI=https://your-site-name.netlify.app/.netlify/functions/admin-oidc-callback
IZHE_ADMIN_REQUIRED_ACR=replace_with_provider_mfa_assurance_level

# Independently generated secrets of at least 32 random bytes each.
IZHE_ADMIN_SESSION_SECRET=replace_with_independent_random_session_secret
IZHE_ADMIN_AUDIT_SIGNING_SECRET=replace_with_independent_random_audit_secret

# Comma-separated verified email addresses permitted ONLY to establish the initial Owner.
# Remove after the durable Owner record is established.
IZHE_ADMIN_BOOTSTRAP_EMAILS=owner@example.com

# Optional comma-separated additional same-origin administration hosts, if needed for a controlled non-production context.
IZHE_ADMIN_ALLOWED_ORIGINS=

# Secure-session durations in seconds. Defaults shown here match the application defaults.
IZHE_ADMIN_SESSION_IDLE_SECONDS=1800
IZHE_ADMIN_SESSION_ABSOLUTE_SECONDS=28800
IZHE_ADMIN_RECENT_AUTH_SECONDS=600
IZHE_ADMIN_SESSION_TOUCH_SECONDS=60

# Optional upload malware scanner. Use an HTTPS endpoint. When document scanning is required,
# the upload fails closed if the scanner is unavailable or not configured.
IZHE_UPLOAD_SCANNER_URL=
IZHE_UPLOAD_SCANNER_API_KEY=
IZHE_UPLOAD_REQUIRE_SCANNER_FOR_DOCUMENTS=true

# Standard U.S. shipping charge in cents: 699 = $6.99.
IZHE_SHIPPING_CENTS=699

# Optional persistent Stripe Shipping Rate ID. When omitted, Checkout creates the rate inline.
STRIPE_STANDARD_SHIPPING_RATE_ID=

# IZHE_ADMIN_TOKEN is intentionally retired and must not be configured for Admin v2.
